# No external services are used by /demo/*.
NEXT_PUBLIC_APP_NAME=Net-Tech Connect
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only; never use NEXT_PUBLIC_ for these.
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
EMAIL_FROM=
CRON_SECRET=
PUBLIC_INTAKE_ENABLED=false
# Required for public intake: Cloudflare Turnstile site/secret keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Set true only after pilot readiness review. Enforces staff aal2 in application + DB setting.
REQUIRE_STAFF_MFA=false
