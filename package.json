{
  "name": "net-tech-connect",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:db": "node --import tsx scripts/test-database.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:db && npm run build",
    "test:concurrency": "node --import tsx scripts/test-concurrency.ts",
    "format": "prettier --write .",
    "seed:local": "node --env-file=.env.local --import tsx scripts/seed-local.ts",
    "test:production": "node scripts/test-production.mjs",
    "seed:testing": "node --env-file=.env.vercel-testing --env-file=.env.test-accounts --import tsx scripts/seed-testing.ts",
    "test:hosted": "node --env-file=.env.vercel-testing --env-file=.env.test-accounts --import tsx scripts/test-hosted.ts",
    "test:deployed": "node --env-file=.env.vercel-testing --env-file=.env.test-accounts --import tsx scripts/test-deployed.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "lucide-react": "1.46.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "17.6.0-beta.15",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.7",
    "supabase": "2.117.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "type": "module"
}
